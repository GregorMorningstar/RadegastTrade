APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Czat w czasie rzeczywistym (Laravel Echo). Bez tych ustawień czat odświeża się zapytaniami co kilka sekund.
# Po uruchomieniu serwera WebSocket zmień BROADCAST_CONNECTION na reverb i odkomentuj:
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Prefiksy kodów kreskowych EAN-13 (4 cyfry z zakresu 2000-2999, zarezerwowanego przez GS1 na użytek wewnętrzny)
BARCODE_PREFIX_USER=2001
BARCODE_PREFIX_ORGANIZATION=2002
BARCODE_PREFIX_WAREHOUSE_HEADQUARTER=2003
BARCODE_PREFIX_SHOP_HEADQUARTER=2004
BARCODE_PREFIX_SHOP_BRANCH=2006
BARCODE_PREFIX_WAREHOUSE_BRANCH=2007
BARCODE_PREFIX_PRODUCT=2005

# NIP verification during registration (Ministry of Finance register)
NIP_REGISTRY_CHECK=true
NIP_REGISTRY_STRICT=false

# ---------------------------------------------------------------------------------------------------------------------
# Produkcja (wdrożenie) — te wartości MUSZĄ być ustawione inaczej niż w środowisku lokalnym:
#   APP_ENV=production
#   APP_DEBUG=false                  (przy true błędy pokazują ścieżki, zapytania i fragmenty środowiska)
#   APP_URL=https://twoja-domena     (HTTPS; w produkcji linki w e-mailach są wymuszane na ten adres)
#   SESSION_SECURE_COOKIE=true       (domyślnie włącza się samo przy APP_ENV=production)
#   SESSION_ENCRYPT=true             (zalecane: sesje w bazie nie są wtedy czytelne)
#   TRUSTED_PROXIES=10.0.0.1         (adresy load balancera / reverse proxy; bez tego limity i audyt widzą adres proxy)
#   MAIL_MAILER=smtp|ses|...         (NIE "log": do logu trafiają kody i linki zaproszeń)
#   REVERB_ALLOWED_ORIGINS=twoja-domena   (kto może otworzyć WebSocket; w produkcji domyślnie host z APP_URL)
#   CORS_ALLOWED_ORIGINS=               (puste: API nie jest dostępne z przeglądarek innych stron)
#   BCRYPT_ROUNDS=12 lub więcej
#   QUEUE_CONNECTION / CACHE_STORE   (wspólne dla wszystkich instancji, jeśli jest ich kilka)
# Konta testowe (DakarSeeder, migracja seed_role_users) powstają wyłącznie przy APP_ENV=local lub testing.
# Po wdrożeniu: php artisan config:cache route:cache; rotacja APP_KEY unieważnia sesje i zaszyfrowane dane (klucze API).
# ---------------------------------------------------------------------------------------------------------------------
